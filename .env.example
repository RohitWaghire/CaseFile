# Copy this file to .env and fill in your values. .env is git-ignored.
# All settings are optional — the app runs without any of them.

# CourtListener REST token (full authenticated opinion text). https://www.courtlistener.com/api/
COURTLISTENER_TOKEN=

# Google Gemini key — enables the Enrich button. https://aistudio.google.com/apikey
GOOGLE_GEMINI_KEY=
GEMINI_MODEL=gemini-flash-latest

# Delivery sinks (POST /api/deliver)
CASEFILE_WEBHOOK_URL=
CASEFILE_ARCHIVE_DIR=
